# /etc/caddy/Caddyfile
#
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# Caddy fetches and renews the TLS certificate automatically. Replace the
# domain below with the real one; it must resolve to this droplet first.

hero-nexus.example.com {
	encode zstd gzip

	# Terminate TLS here, forward plaintext to Next on localhost. Caddy sets
	# X-Forwarded-For / X-Forwarded-Proto / X-Forwarded-Host itself and
	# overwrites anything the client sent — this is what makes trusting
	# X-Forwarded-For in the app safe (see src/server/http.ts).
	reverse_proxy 127.0.0.1:3000

	# Cap upload bodies at the edge, above the largest the app accepts.
	#
	# The app's own ceiling is a sound track at 20 MB (`MAX_AUDIO_BYTES`);
	# images are 8 MB and portraits 4. This was 12 MB, which silently 413'd
	# every track between 12 and 20 before the app could say anything about
	# it. 24 MB leaves room for multipart overhead and nothing more: the app
	# is still the thing that refuses an upload, with a sentence.
	request_body {
		max_size 24MB
	}

	log {
		output file /var/log/caddy/hero-nexus.log
		format json
	}
}
