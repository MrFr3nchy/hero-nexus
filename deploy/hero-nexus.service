# /etc/systemd/system/hero-nexus.service
#
#   sudo cp deploy/hero-nexus.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now hero-nexus
#
# Migrations run on boot (src/instrumentation.ts) and THROW on failure, taking
# the process down on purpose. The restart cap below stops a bad migration from
# crash-looping in silence — after 3 failures in 5 min the unit stays "failed"
# and `systemctl status hero-nexus` / `journalctl -u hero-nexus` shows why.
#
# The server binds 127.0.0.1 only. `next start` defaults to 0.0.0.0, which
# would leave :3000 reachable on the droplet's public IP — and the app trusts
# X-Forwarded-For for its rate-limit keys, so a client that skips Caddy could
# spoof it. `next start` takes the bind address from --hostname alone; a
# HOSTNAME= line in the env file does nothing. See docs/ops/security-decisions.md.
#
# Two env files, both optional (the `-` prefix), `.env` first so `.env.local`
# still wins where one exists. `.env` is the production file: `.env.local` is
# Next's convention for a *developer's* machine-local overrides, and a server
# whose only configuration lives in a file named "local" reads as a mistake
# every time somebody new looks at it. Droplets bootstrapped before this
# carry `.env.local` and keep working untouched.

[Unit]
Description=Hero Nexus (Next.js)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=hero
Group=hero
WorkingDirectory=/opt/hero-nexus
EnvironmentFile=-/opt/hero-nexus/.env
EnvironmentFile=-/opt/hero-nexus/.env.local
Environment=NODE_ENV=production
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Writable paths: the app bundle (Next cache) and the data volume.
ReadWritePaths=/opt/hero-nexus /mnt/hero-nexus-data

[Install]
WantedBy=multi-user.target
