# Copy to .env.local and fill in.
# Generate a secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Canonical public origin, no trailing slash. Used to build links in emails.
# Never inferred from request headers (host-header injection -> poisoned links).
APP_URL=http://localhost:3000

# Transactional email (Resend). Without these, development captures mail to
# the local outbox instead and production refuses to send at all.
RESEND_API_KEY=
MAIL_FROM="Hero Nexus <no-reply@example.com>"

# Which transport sends the mail:
#   resend - Resend's HTTP API. Requires the two settings above.
#   outbox - write it to data/outbox/ and read it at /dev/mail. Dev only;
#            production refuses to start a send over it.
# Unset picks Resend when it is configured and the outbox when it is not, so
# set this only to capture mail locally while a real key is present.
# MAIL_TRANSPORT=outbox

# SQLite database file. Point at a path on the mounted volume in production.
# HERO_NEXUS_DB_PATH=/mnt/hero-nexus-data/hero-nexus.db
