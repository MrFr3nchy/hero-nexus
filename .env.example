# Configuration.
#
#   On a server:      copy to .env      (deploy/bootstrap.sh writes it for you)
#   On your machine:  copy to .env.local
#
# Next reads both, and .env.local wins where they disagree — which is exactly
# what its name is for: a developer's machine-local overrides. A server's
# configuration belongs in .env. The systemd unit loads whichever exist, so a
# droplet set up before this split keeps working with .env.local alone.
#
# Either file holds AUTH_SECRET, so: chmod 600. Both are gitignored.
#
# Generate a secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Canonical public origin, no trailing slash. Used to build links in emails.
# Never inferred from request headers (host-header injection -> poisoned links).
APP_URL=http://localhost:3000

# Transactional email (Resend). Without these, development captures mail to
# the local outbox instead and production refuses to send at all.
RESEND_API_KEY=
MAIL_FROM="Hero Nexus <no-reply@example.com>"

# Which transport sends the mail:
#   resend - Resend's HTTP API. Requires the two settings above.
#   outbox - write it to data/outbox/ and read it at /dev/mail. Dev only;
#            production refuses to start a send over it.
# Unset picks Resend when it is configured and the outbox when it is not, so
# set this only to capture mail locally while a real key is present.
# MAIL_TRANSPORT=outbox

# Where the database and uploads live. Both default to data/ under the repo;
# in production point them at the mounted volume (deploy/bootstrap.sh does).
# HERO_NEXUS_DB_PATH=/mnt/hero-nexus-data/hero-nexus.db
# HERO_NEXUS_UPLOADS_DIR=/mnt/hero-nexus-data/uploads

# Who runs this box. A comma-separated list of addresses; those accounts get
# the /admin page — the shape of the install and the handles on accounts,
# never anybody's campaign, canon or sheet. Leave blank for none.
ADMIN_EMAILS=
